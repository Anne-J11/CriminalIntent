<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Titre incident" />

    <EditText
        android:id="@+id/et_title_crime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Saisissez un titre pour cet incident."
        android:importantForAutofill="no"
        android:inputType="text" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Détails incident" />

    <Button
        android:id="@+id/btn_date_crime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date de l'incident" />

    <CheckBox
        android:id="@+id/cb_crime_resolu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Résolu ?" />

</LinearLayout>